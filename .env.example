# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get from @getidsbot or @userinfobot on Telegram
# For a group/channel: use the negative ID, e.g. -1001234567890
TELEGRAM_CHAT_ID=your_chat_id_here


# ─── ALERT THRESHOLDS (optional, these are the defaults) ─────────────────────
LIQUIDATION_THRESHOLD_USD=1000000       # $1M
TWAP_ALERT_THRESHOLD_USD=1000000        # $1M — real-time alert
TWAP_DIGEST_THRESHOLD_USD=500000        # $500K — shown in digest
SPOT_TRADE_THRESHOLD_USD=1000000        # $1M
PERP_POSITION_THRESHOLD_USD=10000000    # $10M
OI_SPIKE_PERCENT=20                     # 20%
HYPE_STAKE_THRESHOLD=100000             # 100K HYPE

# ─── HYPE PRICE SETTINGS ─────────────────────────────────────────────────────
HYPE_PRICE_STEP=5                       # Alert every $5 milestone
HYPE_SPIKE_PERCENT=5                    # Alert on 5% rapid move
HYPE_SPIKE_WINDOW_MINUTES=15            # Within 15 minutes

# ─── WHALE WATCHLIST THRESHOLDS ──────────────────────────────────────────────
WHALE_DEPOSIT_THRESHOLD_USD=100000      # $100K
WHALE_WITHDRAW_THRESHOLD_USD=100000     # $100K
WHALE_LIQUIDATION_THRESHOLD_USD=50000   # $50K

# ─── SCHEDULING ──────────────────────────────────────────────────────────────
FEES_DIGEST_HOURS=6
TWAP_DIGEST_HOURS=6

# ─── ADVANCED (don't change unless you know what you're doing) ────────────────
ALERT_GROUP_WINDOW_SECONDS=30           # Bundle alerts every 30 seconds
